# Maharashtra Legal Document Generation System — environment variables

# LLM inference
OLLAMA_BASE_URL=http://localhost:11434
LLM_DEFAULT_BACKEND=llama3_8b
CPU_ONLY_MODE=false

# Groq cloud API (fast inference — get free key at console.groq.com/keys)
GROQ_API_KEY=

# Additional Groq API keys for automatic rate-limit rotation (optional)
# Add up to 9 extra free-tier keys — backend rotates on HTTP 429
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=

# Groq API key used specifically for RAGAS Tier 3 evaluation (can be same as GROQ_API_KEY)
GROQ_RAGAS_API_KEY=

# Vector store
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://localhost:6333
FAISS_INDEX_PATH=./data/faiss_index

# Dataset paths
DATASET_ROOT=./Maharashtra Legal Document Dataset
TEMPLATES_DIR=./Legal Document Templates

# Output
OUTPUT_DIR=./output
LOG_DB_PATH=./output/runs.db
LOG_RETENTION_DAYS=30

# Frontend
FRONTEND_PORT=8501
LLM_API_PORT=8000

# Embedding
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32

# Hybrid RAG
HYBRID_ALPHA=0.6

# Evaluation
EVAL_QUERY_SET_PATH=./config/eval_queries.json

# ---------------------------------------------------------------------------
# Phase 1.5 Feature Flags
# Set to "false" to disable all Phase 1.5 features and revert to Phase 1 behaviour.
# ---------------------------------------------------------------------------
ENABLE_PHASE_1_5=true
ENABLE_CITATION_FORMATTING=true
ENABLE_UNDERLINE_FORMATTING=true
ENABLE_MODEL_COMPARISON=true
ENABLE_CHAT_BACKEND=true

# Model Comparison
# Directory where comparison CSVs, JSONs, and Markdown reports are written.
MODEL_COMPARISON_OUTPUT_DIR=./output/model_comparison
# Set to "true" to include 70B+ optional models (requires ≥32 GB RAM).
INCLUDE_LARGE_MODELS=false

# Chat Backend (FastAPI)
CHAT_BACKEND_PORT=8000
# Session storage backend: "memory" (default) or "redis"
CHAT_SESSION_STORE=memory
REDIS_URL=redis://localhost:6379/0
CHAT_SESSION_TTL_MINUTES=30
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Admin API Key — required for the /admin/sessions endpoint
ADMIN_API_KEY=change-me-before-deploying

# HTTPS (production only)
ENABLE_HTTPS=false

          "required": true,
          "ocr_source": null
        },
        {
          "id": "stamp_duty_paid",
          "label": "Stamp duty paid (₹)",
          "type": "number",
          "required": true,
          "ocr_source": null
        },
        {
          "id": "execution_date",
          "label": "Date of execution",
          "type": "date",
          "required": true,
          "ocr_source": null
        }
      ]
    },
    {
      "title": "Witnesses",
      "fields": [
        {
          "id": "witness_1_name",
          "label": "Witness 1 — Full name",
          "type": "text",
          "required": true,
          "ocr_source": null
        },
        {
          "id": "witness_2_name",
          "label": "Witness 2 — Full name",
          "type": "text",
          "required": true,
          "ocr_source": null
        }
      ]
    }
  ]

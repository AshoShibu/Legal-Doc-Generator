{
  "document_type": "affidavit",
  "display_name": "Affidavit",
  "sections": [
    {
      "title": "Deponent",
      "fields": [
        {
          "id": "deponent_name",
          "label": "Full name of Deponent",
          "type": "text",
          "required": true,
          "ocr_source": "owner_name",
          "help": "The person making the affidavit"
        },
        {
          "id": "deponent_age",
          "label": "Age of Deponent (years)",
          "type": "number",
          "required": true,
          "ocr_source": null
        },
        {
          "id": "deponent_occupation",
          "label": "Occupation",
          "type": "text",
          "required": true,
          "ocr_source": null
        },
        {
          "id": "deponent_address",
          "label": "Permanent address",
          "type": "textarea",
          "required": true,
          "ocr_source": null
        }
      ]
    },
    {
      "title": "Purpose",
      "fields": [
        {
          "id": "affidavit_purpose",
          "label": "Purpose of affidavit",
          "type": "select",
          "required": true,
          "options": [
            "Property Ownership",
            "Name Correction",
            "Income Declaration",
            "Address Proof",
            "Date of Birth Proof",
            "Marital Status",
            "Loss of Document",
            "Other"
          ],
          "ocr_source": null
        },
        {
          "id": "purpose_other_details",
          "label": "Describe the purpose",
          "type": "textarea",
          "required": false,
          "ocr_source": null,
          "conditional_on": {"field": "affidavit_purpose", "value": "Other"},
          "help": "Provide details of the specific purpose"
        },
        {
          "id": "authority_to_whom",
          "label": "Authority / office to whom submitted",
          "type": "text",
          "required": false,
          "ocr_source": null,
          "help": "e.g. Sub-Registrar, Pune; Passport Office; Bank"
        }
      ]
    },
